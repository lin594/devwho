[
  {
    "name": "empty-profile",
    "toml": "version=1\n[profiles.a]\n",
    "valid": true,
    "env": {
      "DEVWHO_PROFILE": "a"
    }
  },
  {
    "name": "inline-tables",
    "toml": "version=1\nprofiles.a={env={VALUE=\"inline\",EMPTY=\"\"}}\n",
    "valid": true,
    "env": {
      "VALUE": "inline",
      "EMPTY": ""
    }
  },
  {
    "name": "quoted-dotted-keys",
    "toml": "version=1\n[\"profiles\".\"a\".\"env\"]\n\"VALUE\"=\"quoted\"\n",
    "valid": true,
    "env": {
      "VALUE": "quoted"
    }
  },
  {
    "name": "multiline-and-unicode",
    "toml": "version=1\n[profiles.a.env]\nVALUE=\"\"\"\nline one\nline two\"\"\"\nSNOW=\"\\u96EA\\U0001F680\"\n",
    "valid": true,
    "env": {
      "VALUE": "line one\nline two",
      "SNOW": "雪🚀"
    }
  },
  {
    "name": "literal-and-escaped",
    "toml": "version=1\n[profiles.a.env]\nVALUE='${HOME} $(touch marker) `touch other`'\nCONTROL=\"\\u0001\\t\\n\"\n",
    "valid": true,
    "env": {
      "VALUE": "${HOME} $(touch marker) `touch other`",
      "CONTROL": "\u0001\t\n"
    }
  },
  {
    "name": "multiline-literal",
    "toml": "version=1\n[profiles.a.env]\nVALUE='''\nline1\nline2'''\n",
    "valid": true,
    "env": {
      "VALUE": "line1\nline2"
    }
  },
  {
    "name": "git-pair-order",
    "toml": "version=1\n[profiles.a.git.config]\n\"z.first\"=[\"one\",\n\"two\",]\n\"a.last\"=\"three\"\n",
    "valid": true,
    "runtime": [
      [
        "z.first",
        "one"
      ],
      [
        "z.first",
        "two"
      ],
      [
        "a.last",
        "three"
      ]
    ]
  },
  {
    "name": "signing",
    "toml": "version=1\n[profiles.a.git]\nsigning_key=\"fixture\"\nsigning_format=\"ssh\"\nsign_commits=false\n",
    "valid": true,
    "runtime": [
      [
        "user.signingKey",
        "fixture"
      ],
      [
        "gpg.format",
        "ssh"
      ],
      [
        "commit.gpgSign",
        "false"
      ]
    ]
  },
  {
    "name": "typed-identity",
    "toml": "version=1\n[profiles.a.git]\nname=\"Sample User\"\nemail=\"sample@example.test\"\n",
    "valid": true,
    "runtime": [
      [
        "user.name",
        "Sample User"
      ],
      [
        "user.email",
        "sample@example.test"
      ],
      [
        "author.name",
        "Sample User"
      ],
      [
        "author.email",
        "sample@example.test"
      ],
      [
        "committer.name",
        "Sample User"
      ],
      [
        "committer.email",
        "sample@example.test"
      ]
    ]
  },
  {
    "name": "windows-newlines",
    "toml": "version = 1\r\n[profiles.a.env]\r\nVALUE = \"crlf\"\r\n",
    "valid": true,
    "env": {
      "VALUE": "crlf"
    }
  },
  {
    "name": "inline-nested",
    "toml": "version=1\n[profiles]\na={env={A=\"a\",B=\"b\"},unset_env=[\"DROP\"]}\n",
    "valid": true,
    "env": {
      "A": "a",
      "B": "b",
      "DROP": null
    }
  },
  {
    "name": "escaped-quoted-key",
    "toml": "version=1\n[profiles.a.env]\n\"V\\u0041LUE\"=\"decoded\"\n",
    "valid": true,
    "env": {
      "VALUE": "decoded"
    }
  },
